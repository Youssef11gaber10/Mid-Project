POSTGRES_HOST=postgres # name of service in docker compose will be replaced with ip of the container # must be same 
POSTGRES_PORT=5432 #default
POSTGRES_USER=user # will use in 2 position creating user in postgress throw env variable , and connect backend to db throw env variable
POSTGRES_PASSWORD=password # will use in 2 position creating user in postgress throw env variable , and connect backend to db throw env variable
POSTGRES_DB=microservices_db # will use in 2 position creating user in postgress throw env variable , and connect backend to db throw env variable
# this file only if you want to run docker-compose-dev.yml with prodution must create vault.yml put you enviroment in it

# this file put in enviroment variable files all theese variable for both containers postgres db , backend and each one in 
# for ex i db use user, pass ,db name only , and in back end use them all  , both containers have all theese enviroment variable in  their env variable files
